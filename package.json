{
  "name": "branch-tabs",
  "displayName": "Branch Tabs",
  "description": "Remembers which files you had open on each git branch and restores them when you switch back",
  "version": "0.0.1",
  "publisher": "TODO-publisher-id",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZachGrande/branchtabs.git"
  },
  "bugs": {
    "url": "https://github.com/ZachGrande/branchtabs/issues"
  },
  "homepage": "https://github.com/ZachGrande/branchtabs#readme",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "git",
    "branch",
    "tabs",
    "editors",
    "workspace",
    "session"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
